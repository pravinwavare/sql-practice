---
import SiteLayout from '../layouts/SiteLayout.astro';
import { databases, getRecordCount } from '../data/databases';
const title = 'SQL Sample Databases — SQL Practice';
const description = 'Explore the Hospital, Company, and E-commerce SQLite sample databases used for SQL practice.';
---
<SiteLayout title={title} description={description}>
  <main class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <p class="text-sm font-semibold text-teal-800">Databases</p><h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">Get to know the data.</h1>
    <p class="mt-4 max-w-2xl leading-7 text-slate-600">Explore a schema before you query it. Each database includes small, related tables and realistic sample records.</p>
    <ul class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {databases.map((database) => <li class="py-5"><div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div><a href={`/databases/${database.id}/`} class="text-lg font-semibold text-slate-900 hover:text-teal-800">{database.name}</a><p class="mt-1 text-sm text-slate-600">{database.summary}</p></div><a href={`/databases/${database.id}/`} class="text-sm font-semibold text-teal-800">Explore schema →</a></div><div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-slate-500">{database.tables.map((table) => <span><code>{table.name}</code> · {getRecordCount(database, table.name)} rows</span>)}</div></li>)}
    </ul>
    <a href="/playground/" class="mt-7 inline-flex text-sm font-semibold text-teal-800">Open the SQL playground →</a>
  </main>
</SiteLayout>
