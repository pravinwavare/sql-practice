---
import DatabaseSidebar from '../components/DatabaseSidebar.astro';
import QueryEditor from '../components/QueryEditor.astro';
import ResultsPanel from '../components/ResultsPanel.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const title = 'SQL Playground — SQL Practice';
const description = 'Explore the Hospital Database schema and write SQL queries in the SQL Practice playground.';
---

<SiteLayout title={title} description={description}>
  <main class="mx-auto min-h-[calc(100vh-12rem)] max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-teal-800">Playground</p>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-950">Write a query. Explore the data.</h1>
        <p class="mt-1.5 text-sm text-slate-600">Choose a table to view its columns, then start writing SQL.</p>
      </div>
      <button id="toggle-database" type="button" aria-expanded="true" aria-controls="database-sidebar" class="inline-flex min-h-10 items-center justify-center gap-2 self-start rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700 md:hidden">
        <svg viewBox="0 0 16 16" fill="none" class="size-4" aria-hidden="true"><path d="M2.5 3.25h11m-11 4h11m-11 4h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <span id="database-toggle-label">Hide database</span>
      </button>
    </div>

    <div class="grid min-w-0 grid-cols-1 overflow-hidden rounded-lg border border-slate-200 bg-white md:grid-cols-[16rem_minmax(0,1fr)]">
      <DatabaseSidebar />
      <div class="min-w-0 space-y-4 bg-slate-50/60 p-3 sm:p-4">
        <QueryEditor />
        <ResultsPanel />
        <p id="engine-status" class="px-1 text-xs text-slate-500" role="status" aria-live="polite">Preparing the Hospital Database…</p>
      </div>
    </div>
  </main>

  <style>
    @media (max-width: 47.999rem) {
      #database-sidebar[data-collapsed='true'] {
        display: none;
      }
    }
  </style>

  <script>
    import { mountPlayground } from '../scripts/playground';
    mountPlayground();
  </script>
</SiteLayout>
