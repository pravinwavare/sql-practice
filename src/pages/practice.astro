---
import SiteLayout from '../layouts/SiteLayout.astro';
import { questions, topics } from '../data/questions';
const title = 'SQL Practice Questions — SQL Practice';
const description = 'Work through 40 SQL practice questions covering filtering, sorting, aggregates, joins, subqueries, CASE, and NULL values.';
---
<SiteLayout title={title} description={description}>
  <main class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <p class="text-sm font-semibold text-teal-800">Practice</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">Build your SQL skills step by step.</h1>
    <p class="mt-4 max-w-2xl leading-7 text-slate-600">Choose a topic and solve practical questions against the Hospital Database. Your progress is saved in this browser.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-y border-slate-200 py-4 text-sm text-slate-600"><span><strong id="practice-progress-count" class="text-slate-900">0</strong> of {questions.length} completed</span><button id="clear-practice-progress" class="text-teal-800 underline decoration-slate-300 underline-offset-4 hover:text-teal-950">Clear saved progress</button></div>
    <h2 class="mt-9 text-xl font-semibold text-slate-900">Topics</h2>
    <ul class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
      {topics.map((topic) => { const count = questions.filter((question) => question.topic === topic.slug).length; return <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-center sm:justify-between"><div><a class="font-semibold text-slate-800 hover:text-teal-800" href={`/practice/${topic.slug}/`}>{topic.title}</a><p class="mt-1 text-sm text-slate-500">{topic.description}</p></div><span class="text-sm text-slate-500">{count} questions</span></li>; })}
    </ul>
    <p class="mt-8 text-sm text-slate-500">All questions use a fresh copy of the sample database when checked. Your playground data stays separate.</p>
  </main>
  <script>
    import { clearProgress, progressSummary, readProgress } from '../lib/progress';
    const counter = document.querySelector('#practice-progress-count');
    const update = () => { if (counter) counter.textContent = String(progressSummary(readProgress()).solved); };
    document.querySelector('#clear-practice-progress')?.addEventListener('click', () => { if (confirm('Clear all saved practice progress on this browser?')) { clearProgress(); update(); } });
    update();
  </script>
</SiteLayout>
