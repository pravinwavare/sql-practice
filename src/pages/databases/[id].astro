---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { databases, type DatabaseId } from '../../data/databases';
import { questions } from '../../data/questions';
export function getStaticPaths() { return databases.map((database) => ({ params:{id:database.id} })); }
const database = databases.find((item) => item.id === Astro.params.id)!;
const relatedQuestions = questions.filter((question) => question.databaseId === database.id).slice(0, 5);
const title = `${database.name} Schema — SQL Practice`;
const description = `${database.purpose} Explore ${database.tables.length} tables and their columns.`;
const breadcrumbs = [{name:'Databases',path:'/databases/'},{name:database.name,path:`/databases/${database.id}/`}];
---
<SiteLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <main class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500"><a href="/databases/" class="hover:text-teal-800">Databases</a><span aria-hidden="true"> / </span><span>{database.name}</span></nav>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950">{database.name}</h1><p class="mt-3 max-w-3xl leading-7 text-slate-600">{database.purpose}</p>
    <p class="mt-3 text-sm text-slate-500">{database.tables.length} tables · {database.tables.reduce((sum,table)=>sum+table.rows.length,0)} sample rows · SQLite</p>
    <h2 class="mt-9 text-xl font-semibold">Tables and columns</h2>
    <div class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
      {database.tables.map((table) => <section class="py-5"><div class="flex flex-wrap items-baseline justify-between gap-2"><h3 class="font-semibold text-slate-900"><code>{table.name}</code></h3><span class="text-xs text-slate-500">{table.rows.length} rows</span></div><p class="mt-1 text-sm text-slate-600">{table.description}</p><div class="mt-3 overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="text-xs text-slate-500"><tr><th class="py-2 pr-6 font-medium">Column</th><th class="py-2 pr-6 font-medium">Type</th><th class="py-2 pr-6 font-medium">Details</th></tr></thead><tbody class="divide-y divide-slate-100">{table.columns.map((column) => <tr><td class="py-2 pr-6 font-mono text-slate-800">{column.name}</td><td class="py-2 pr-6 text-slate-600">{column.type}</td><td class="py-2 pr-6 text-slate-600">{column.description}{column.primaryKey?' · primary key':''}{column.references?` · references ${column.references.table}.${column.references.column}`:''}{column.nullable?' · nullable':''}</td></tr>)}</tbody></table></div></section>)}
    </div>
    <section class="mt-9"><h2 class="text-xl font-semibold">Relationships</h2><ul class="mt-3 space-y-2 text-sm text-slate-600">{database.relationships.map((relation) => <li><code>{relation.fromTable}.{relation.fromColumn}</code> → <code>{relation.toTable}.{relation.toColumn}</code> — {relation.description}</li>)}</ul></section>
    {relatedQuestions.length > 0 && <section class="mt-9"><h2 class="text-xl font-semibold">Practice with this data</h2><ul class="mt-3 divide-y divide-slate-200 border-y border-slate-200">{relatedQuestions.map((question)=><li class="py-3"><a href={`/practice/questions/${question.slug}/`} class="font-medium text-teal-800 hover:text-teal-950">{question.title}</a></li>)}</ul></section>}
    <a href="/playground/" class="mt-8 inline-flex rounded-md bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-800">Open in playground</a>
  </main>
</SiteLayout>
