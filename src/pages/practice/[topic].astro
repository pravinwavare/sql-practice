---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { topics, questionsForTopic, questions } from '../../data/questions';
export function getStaticPaths() { return topics.map((topic) => ({ params: { topic: topic.slug } })); }
const topic = topics.find((entry) => entry.slug === Astro.params.topic)!;
const topicQuestions = questionsForTopic(topic.slug);
const title = `${topic.title} SQL Questions — SQL Practice`;
const description = `${topic.description} Practice with ${topicQuestions.length} interactive SQL questions.`;
const breadcrumbs = [{name:'Practice',path:'/practice/'},{name:topic.title,path:`/practice/${topic.slug}/`}];
---
<SiteLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <main class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500"><a href="/practice/" class="hover:text-teal-800">Practice</a><span aria-hidden="true"> / </span><span>{topic.title}</span></nav>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950">{topic.title}</h1>
    <p class="mt-3 max-w-2xl leading-7 text-slate-600">{topic.description}</p>
    <ol class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {topicQuestions.map((question, index) => <li class="flex flex-col gap-2 py-4 sm:flex-row sm:items-center sm:justify-between"><div><span class="mr-2 text-sm text-slate-400">{String(index + 1).padStart(2,'0')}</span><a href={`/practice/questions/${question.slug}/`} class="font-semibold text-slate-800 hover:text-teal-800">{question.title}</a><p class="mt-1 pl-8 text-sm text-slate-500">{question.prompt}</p></div><span class="self-start rounded-full bg-slate-100 px-2.5 py-1 text-xs capitalize text-slate-600 sm:self-center">{question.difficulty}</span></li>)}
    </ol>
    <a href="/practice/" class="mt-7 inline-flex text-sm font-semibold text-teal-800 hover:text-teal-950">← All practice topics</a>
  </main>
</SiteLayout>
