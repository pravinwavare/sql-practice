---
import DatabaseSidebar from './DatabaseSidebar.astro';
import LearningPanel from './LearningPanel.astro';
import QueryEditor from './QueryEditor.astro';
import ResultsPanel from './ResultsPanel.astro';
---

<main class="workspace-shell">
  <section class="workspace-heading" aria-labelledby="workspace-title">
    <div>
      <div class="eyebrow"><span class="live-dot" aria-hidden="true"></span> SQL playground <span class="eyebrow-divider">/</span> SQLite</div>
      <h1 id="workspace-title">Write a query. See what it does.</h1>
      <p>Explore a sample database and run SQL right here in your browser.</p>
    </div>
    <div class="heading-actions">
      <a class="practice-link" href="/practice/" aria-label="Open SQL practice questions">
        <span class="practice-icon" aria-hidden="true">✳</span>
        Practice questions <span aria-hidden="true">↗</span>
      </a>
      <button id="toggle-database" type="button" aria-expanded="true" aria-controls="database-sidebar" class="sidebar-toggle">
        <span aria-hidden="true">☷</span><span id="database-toggle-label">Hide schema</span>
      </button>
    </div>
  </section>

  <div class="workspace-grid">
    <DatabaseSidebar />
    <div class="workspace-main">
      <QueryEditor />
      <ResultsPanel />
      <div class="workspace-footnote">
        <span class="privacy-dot" aria-hidden="true"></span>
        <p id="engine-status" role="status" aria-live="polite">Preparing the Hospital Database…</p>
        <span class="local-note">Runs locally in your browser</span>
      </div>
    </div>
    <LearningPanel />
  </div>
</main>

<style>
  .workspace-shell { width: min(1480px, 100%); margin: 0 auto; padding: 28px clamp(16px, 3vw, 42px) 36px; }
  .workspace-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin: 4px 0 20px; }
  .eyebrow { display: flex; align-items: center; gap: 8px; color: #596b70; font-size: 11px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .live-dot, .privacy-dot { width: 8px; height: 8px; border-radius: 50%; background: #21a783; box-shadow: 0 0 0 3px #e2f5ef; }
  .eyebrow-divider { color: #c1cdcc; }
  .workspace-heading h1 { margin: 10px 0 5px; color: #152e31; font-size: clamp(24px, 3vw, 32px); line-height: 1.16; letter-spacing: -.045em; font-weight: 680; }
  .workspace-heading p { margin: 0; color: #68797d; font-size: 14px; }
  .heading-actions { display: flex; align-items: center; gap: 10px; }
  .practice-link, .sidebar-toggle { display: inline-flex; min-height: 40px; align-items: center; justify-content: center; gap: 9px; border: 1px solid #dce6e3; border-radius: 9px; padding: 0 13px; background: #fff; color: #334c4d; font-size: 13px; font-weight: 650; text-decoration: none; transition: .18s ease; }
  .practice-link:hover, .sidebar-toggle:hover { border-color: #9bc9bb; background: #f7fbf9; color: #176c58; }
  .practice-icon { color: #168269; font-size: 15px; }
  .sidebar-toggle { display: none; cursor: pointer; }
  .workspace-grid { display: grid; grid-template-columns: 245px minmax(420px, 1fr) 300px; min-width: 0; overflow: hidden; border: 1px solid #dce6e3; border-radius: 13px; background: #fff; box-shadow: 0 14px 40px rgb(27 55 52 / 7%); }
  .workspace-main { display: grid; align-content: start; gap: 14px; min-width: 0; padding: 16px; background: #f5f8f7; }
  .workspace-footnote { display: flex; align-items: center; gap: 9px; min-height: 21px; padding: 0 2px; color: #657778; font-size: 11px; }
  .privacy-dot { width: 6px; height: 6px; flex: 0 0 auto; box-shadow: none; }
  .workspace-footnote p { margin: 0; }
  .local-note { margin-left: auto; color: #8b9999; }
  @media (max-width: 1120px) { .workspace-grid { grid-template-columns: 220px minmax(0, 1fr); } .workspace-grid > :global(.learning-panel) { grid-column: 1 / -1; border-top: 1px solid #e3ebe8; } }
  @media (max-width: 760px) {
    .workspace-shell { padding-top: 20px; }
    .workspace-heading { align-items: start; }
    .sidebar-toggle { display: inline-flex; }
    .practice-link { min-height: 38px; }
    .workspace-grid { grid-template-columns: minmax(0,1fr); }
    .workspace-grid > :global(.learning-panel) { grid-column: auto; }
    .workspace-main { padding: 10px; }
  }
  @media (max-width: 520px) {
    .workspace-heading { flex-direction: column; gap: 14px; }
    .heading-actions { width: 100%; justify-content: space-between; }
    .local-note { display: none; }
  }
</style>

<script>
  import { mountPlayground } from '../scripts/playground';
  mountPlayground();
</script>
