---
import { databases, defaultDatabaseId } from '../data/databases';
const database = databases.find((entry) => entry.id === defaultDatabaseId)!;
---
<aside id="database-sidebar" class="min-w-0 border-b border-slate-200 bg-white md:border-b-0 md:border-r" aria-label="Database schema">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
    <div><p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Database</p><label for="database-select" class="sr-only">Select a database</label></div>
    <select id="database-select" class="max-w-44 rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-sm font-medium text-slate-800 outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-100">
      {databases.map((entry) => <option value={entry.id} selected={entry.id === defaultDatabaseId}>{entry.name}</option>)}
    </select>
  </div>
  <div class="p-3">
    <input id="database-file" type="file" accept=".db,.sqlite,.sqlite3,.sql,application/vnd.sqlite3,text/plain" class="sr-only" />
    <button id="import-database" type="button" class="mb-3 inline-flex min-h-9 w-full items-center justify-center gap-2 rounded-md border border-teal-200 bg-teal-50 px-3 text-xs font-semibold text-teal-800 hover:bg-teal-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Import a database</button>
    <p class="mb-3 px-1 text-[11px] leading-4 text-slate-500">SQLite files (.db, .sqlite) or SQLite .sql dumps. Loaded in this tab; nothing is uploaded.</p>
    <div class="mb-2 flex items-center justify-between px-2"><p class="text-xs font-semibold tracking-wide text-slate-500">TABLES</p><span class="text-[10px] text-slate-400">Click a column to insert</span></div>
    <div id="schema-tables" class="space-y-1">
      {database.tables.map((table, index) => (
        <details open={index === 0} class="group rounded-md">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-teal-700">
            <span aria-hidden="true" class="text-teal-700">▦</span><span class="flex-1">{table.name}</span><span aria-hidden="true" class="text-slate-400">⌄</span>
          </summary>
          <button type="button" data-table-query={table.name} class="ml-8 mt-1 rounded-md px-2 py-1 text-[11px] font-semibold text-teal-800 hover:bg-teal-50">Use SELECT * from {table.name}</button>
          <ul class="ml-[1.15rem] border-l border-slate-200 py-1 pl-3 text-xs">
            {table.columns.map((column) => <li class="flex items-center gap-2 py-1.5"><span class:list={['size-3.5 shrink-0', column.primaryKey ? 'text-amber-600' : column.references ? 'text-sky-700' : 'text-transparent']} title={column.primaryKey ? 'Primary key' : column.references ? `Foreign key to ${column.references.table}.${column.references.column}` : ''} aria-hidden="true">{column.primaryKey ? '◆' : column.references ? '↗' : '·'}</span><button type="button" data-column-query={column.name} class="min-w-0 truncate text-left text-slate-700 hover:text-teal-800" aria-label={`Insert ${column.name} into query`}><code>{column.name}</code></button><span class="ml-auto text-slate-400">{column.type}</span></li>)}
          </ul>
        </details>
      ))}
    </div>
    <div id="schema-relationships" class="mx-3 mt-4 border-t border-slate-200 pt-3">
      <p class="mb-2 text-xs font-semibold tracking-wide text-slate-500">RELATIONSHIPS</p>
      {database.relationships.map((relation) => <p class="py-1 text-xs leading-5 text-slate-600" title={relation.description}><code>{relation.fromTable}.{relation.fromColumn}</code> → <code>{relation.toTable}.{relation.toColumn}</code></p>)}
    </div>
    <div class="mt-4 border-t border-slate-200 pt-3">
      <button id="reset-database" type="button" class="inline-flex min-h-9 w-full items-center justify-center gap-2 rounded-md px-2 py-2 text-xs font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">Reset database</button>
      <p class="px-2 pt-1 text-[11px] leading-4 text-slate-400">Restore the original sample data.</p>
    </div>
  </div>
</aside>
