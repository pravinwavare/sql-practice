<section class="min-w-0 overflow-hidden rounded-lg border border-slate-200 bg-white" aria-label="Query output">
  <div role="tablist" aria-label="Query output tabs" class="flex items-center gap-1 border-b border-slate-200 px-3">
    <button id="results-tab" type="button" role="tab" aria-selected="true" aria-controls="results-panel" class="border-b-2 border-teal-700 px-3 py-3 text-sm font-semibold text-slate-900">Results</button>
    <button id="messages-tab" type="button" role="tab" aria-selected="false" aria-controls="messages-panel" class="border-b-2 border-transparent px-3 py-3 text-sm font-medium text-slate-500 hover:text-slate-800">Messages</button>
  </div>
  <div id="results-panel" role="tabpanel" aria-labelledby="results-tab" class="min-h-40">
    <div id="results-empty" class="flex min-h-40 items-center justify-center px-5 py-8 text-center">
      <span class="mx-auto grid size-9 place-items-center rounded-full bg-slate-100 text-slate-500" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" class="size-5"><rect x="2.5" y="3" width="15" height="14" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M3 7h14M7 7v9m6-9v9" stroke="currentColor" stroke-width="1.2"/></svg>
      </span>
      <div><p class="mt-3 text-sm font-medium text-slate-700">Your results will appear here</p><p class="mt-1 text-xs text-slate-500">Run a query to see its output.</p></div>
    </div>
    <div id="results-output" class="hidden">
      <div id="result-summary" class="border-b border-slate-200 px-4 py-2.5 text-xs text-slate-500"></div>
      <div id="result-content" class="divide-y divide-slate-200"></div>
    </div>
  </div>
  <div id="messages-panel" role="tabpanel" aria-labelledby="messages-tab" class="hidden min-h-40 px-5 py-5" aria-live="polite">
    <p id="query-message" class="text-sm leading-6 text-slate-600">Messages will appear here.</p>
  </div>
</section>
